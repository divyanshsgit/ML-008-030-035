# ==========================================
# Mandi Forecast App - .gitignore
# ==========================================

# --- Frontend (Node / Vite / React) ---
node_modules/
frontend/node_modules/
dist/
dist-ssr/
*.local
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Backend (Python / Flask) ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/__pycache__/

# Python Virtual Environments
.venv/
venv/
env/
ENV/
backend/.venv/

# --- Datasets & Uploaded Data (Do not push to GitHub) ---
*.csv
*.tsv
*.xlsx
*.xls
*.parquet
*.feather
backend/uploads/*
!backend/uploads/.gitkeep
data/

# --- Machine Learning Artifacts & Checkpoints ---
*.pkl
*.pickle
*.joblib
*.h5
*.keras
*.onnx

# --- Environment Variables & Secrets ---
.env
.env.*
!.env.example

# --- Operating System Files ---
.DS_Store
Thumbs.db
desktop.ini

# --- Logs & Temporary Files ---
*.log
*.tmp
*.bak
*.swp
temp/
